{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "llvm-mingw",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "D:/Qt/Tools/llvm-mingw2217_64/bin/clang++.exe",
        "CMAKE_MAKE_PROGRAM": "D:/Qt/Tools/Ninja/ninja.exe",
        "CMAKE_PREFIX_PATH": "D:/Qt/6.12.0/llvm-mingw_64"
      },
      "environment": {
        "PATH": "D:/Qt/Tools/llvm-mingw2217_64/bin;D:/Qt/Tools/Ninja;D:/Qt/6.12.0/llvm-mingw_64/bin;$penv{PATH}"
      }
    },
    {
      "name": "debug",
      "inherits": "llvm-mingw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "llvm-mingw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
